# Copy to .env.local for local development. .env.local is gitignored.

# ── Database ─────────────────────────────────────────────────────────────────
# Auth DB connection string. Local dev usually points at the local Postgres
# running the gcp-universal-backend schema. Cloud Run deploys inject this via
# Secret Manager (dev-gub-admin-db-url; see cloudbuild/dev.yaml).
DATABASE_URL=postgresql://gub_dev:change_me@localhost:5432/gub_dev

# ── GUB backend URL (server-side + client-side) ──────────────────────────────
# Used by every /api/* proxy route to call the GCP universal backend.
# In production, set via cloudbuild to the deployed backend URL.
GUB_BACKEND_URL=http://localhost:3000
# Public fallback (frontend SDK reads this when GUB_BACKEND_URL isn't set).
NEXT_PUBLIC_GUB_URL=http://localhost:3000

# ── IAP dev-email bypass (local development ONLY) ────────────────────────────
# When set AND NODE_ENV=development AND the request Host is localhost, this
# shortcuts past Cloud IAP and authenticates the request as this email.
# The startup guard in src/lib/iap-dev-bypass.ts refuses to boot if this
# var is set but NODE_ENV is anything other than 'development' — NEVER set
# this on a deployed Cloud Run service.
IAP_DEV_EMAIL=you@yourdomain.com

# ── Node environment (set by Next automatically — rarely need to override) ───
# `next dev` sets NODE_ENV=development; `next build && next start` uses
# production. Deployed Cloud Run services set NODE_ENV=production explicitly
# (see cloudbuild/dev.yaml) so the IAP guard above stays armed.
# NODE_ENV=development

# ── Bot OAuth flow (auth-no-DWD migration; Settings → Sync Credentials) ──────
# Dedicated OAuth 2.0 client used to authorize Workspace bot users (one per
# unattended sync surface — directory, drive, groups). gub-admin needs both
# values to perform the code → token exchange in the OAuth callback. GUB
# backend has the same pair set in its env to mint access tokens at sync
# time. Same Secret Manager entry, two consumers. Distinct from
# GOOGLE_CLIENT_ID, which is for ID-token verification only.
#
# Optional — without these, the Settings page renders a "not configured"
# message instead of an Authorize button. The local dev bypass means you
# can browse the page; you just can't complete the consent flow until the
# OAuth client exists.
#
# Authorized redirect URI in the OAuth client must match (callback URL):
#   http://localhost:5173/api/sync-credentials/oauth-callback   (local dev)
#   https://gub-admin.<env>.example/api/sync-credentials/oauth-callback  (deployed)
GUB_BOT_OAUTH_CLIENT_ID=
GUB_BOT_OAUTH_CLIENT_SECRET=

# ── Public base URL of gub-admin (server-side use; OAuth redirect_uri) ───────
# Used to construct the redirect_uri for the bot-OAuth flow. Falls back to
# computing from request headers if unset, but explicit is safer behind a
# load balancer that strips the original Host. Match the value registered
# in the bot OAuth client's Authorized redirect URIs.
NEXT_PUBLIC_GUB_ADMIN_URL=http://localhost:5173
